#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_DIR="${GOST_SNI_STATE_DIR:-/etc/gost-sni-forward}"
readonly DOMAINS_FILE="${GOST_SNI_DOMAINS_FILE:-$STATE_DIR/domains.txt}"
readonly FORWARDS_FILE="${GOST_SNI_FORWARDS_FILE:-$STATE_DIR/forwards.tsv}"
readonly CONFIG_FILE="${GOST_SNI_CONFIG_FILE:-$STATE_DIR/gost.yml}"
readonly LOCK_FILE="${GOST_SNI_LOCK_FILE:-$STATE_DIR/manager.lock}"
readonly INSTALL_ROOT="${GOST_SNI_INSTALL_ROOT:-/usr/local/lib/gost-sni-forward}"
readonly CORE_BIN="${GOST_SNI_CORE_BIN:-${GOST_SNI_GOST_BIN:-$INSTALL_ROOT/gost-core}}"
readonly MANAGER_BIN="${GOST_SNI_MANAGER_BIN:-/usr/local/bin/gost}"
readonly COMPAT_MANAGER_BIN="${GOST_SNI_COMPAT_MANAGER_BIN:-/usr/local/sbin/gost-sni}"
readonly SERVICE_NAME="${GOST_SNI_SERVICE_NAME:-gost-sni-forward.service}"
readonly PROJECT_REPO="${GOST_SNI_REPO:-666speed/gost-sni-forward}"
readonly PROJECT_REF="${GOST_SNI_REF:-main}"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    readonly C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m'
    readonly C_BLUE=$'\033[36m' C_BOLD=$'\033[1m' C_RESET=$'\033[0m'
else
    readonly C_RED='' C_GREEN='' C_YELLOW='' C_BLUE='' C_BOLD='' C_RESET=''
fi

info() { printf '%s[信息]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[提示]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die() { printf '%s[错误]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

require_root() {
    if (( EUID != 0 )) && [[ "${GOST_SNI_ALLOW_NON_ROOT:-0}" != 1 ]]; then
        if [[ -x /usr/bin/sudo && -x "$MANAGER_BIN" ]]; then
            exec /usr/bin/sudo -- "$MANAGER_BIN" "$@"
        fi
        die "需要 root 权限，且无法自动调用 sudo。"
    fi
}

init_state() {
    install -d -m 0755 "$STATE_DIR"
    touch "$DOMAINS_FILE" "$FORWARDS_FILE"
    chmod 0600 "$DOMAINS_FILE" "$FORWARDS_FILE"
}

normalize_domain() {
    local domain="${1,,}"
    domain="${domain#\*.}"
    domain="${domain#.}"
    domain="${domain%.}"
    printf '%s' "$domain"
}

valid_domain() {
    local domain label
    domain="$(normalize_domain "$1")"
    (( ${#domain} <= 253 )) || return 1
    [[ "$domain" == *.* ]] || return 1
    [[ "$domain" =~ ^[a-z0-9.-]+$ ]] || return 1
    IFS='.' read -r -a labels <<<"$domain"
    for label in "${labels[@]}"; do
        (( ${#label} >= 1 && ${#label} <= 63 )) || return 1
        [[ "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
    done
}

valid_port() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]] && (( 10#$1 <= 65535 ))
}

valid_rule_name() {
    [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,31}$ ]]
}

valid_ipv4() {
    local value="$1" part
    local -a parts
    IFS='.' read -r -a parts <<<"$value"
    (( ${#parts[@]} == 4 )) || return 1
    for part in "${parts[@]}"; do
        [[ "$part" =~ ^[0-9]{1,3}$ ]] || return 1
        [[ "$part" == "0" || "$part" != 0* ]] || return 1
        (( 10#$part <= 255 )) || return 1
    done
    [[ "$value" != "0.0.0.0" && "$value" != "255.255.255.255" ]]
}

valid_target() {
    valid_ipv4 "$1"
}

format_endpoint() {
    printf '%s:%s' "$1" "$2"
}

slugify() {
    local value="${1,,}"
    value="${value//./-}"
    value="${value//_/-}"
    value="${value//[^a-z0-9-]/-}"
    printf '%.48s' "$value"
}

regex_domain() {
    local value="$1"
    printf '%s' "$value" | sed 's/\./\\./g'
}

systemctl_available() {
    [[ "${GOST_SNI_SKIP_SYSTEMD:-0}" != 1 ]] && command -v systemctl >/dev/null 2>&1
}

config_ready() {
    [[ -s "$DOMAINS_FILE" && -s "$FORWARDS_FILE" ]]
}

apply_service() {
    if systemctl_available; then
        systemctl daemon-reload || return 1
        if config_ready; then
            systemctl enable "$SERVICE_NAME" >/dev/null || return 1
            systemctl restart "$SERVICE_NAME" || return 1
            sleep 1
            systemctl is-active --quiet "$SERVICE_NAME"
        else
            systemctl disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
        fi
    else
        return 0
    fi
}

render_config() {
    local output="$1" domain regex endpoint node_name node_index
    local name listen_port target target_port
    local -a domains forwards
    mapfile -t domains < <(sed '/^[[:space:]]*$/d' "$DOMAINS_FILE" | sort -u)
    mapfile -t forwards < <(sed '/^[[:space:]]*$/d' "$FORWARDS_FILE")

    {
        printf '# 由 gost 管理菜单自动生成，请勿手工修改。\n'
        printf '# 未匹配全局主域名白名单的 SNI、无 SNI、非 TLS 流量均不会连接上游。\n'
        if (( ${#domains[@]} == 0 || ${#forwards[@]} == 0 )); then
            printf 'services: []\n'
        else
            printf 'services:\n'
            while IFS=$'\t' read -r name listen_port target target_port; do
                [[ -n "${name:-}" ]] || continue
                endpoint="$(format_endpoint "$target" "$target_port")"
                printf '  - name: "%s"\n' "$name"
                printf '    addr: "0.0.0.0:%s"\n' "$listen_port"
                printf '    bypass: "global-sni-allowlist"\n'
                printf '    handler:\n'
                printf '      type: tcp\n'
                printf '      metadata:\n'
                printf '        sniffing: true\n'
                printf '        sniffing.timeout: 5s\n'
                printf '    listener:\n'
                printf '      type: tcp\n'
                printf '    forwarder:\n'
                printf '      selector:\n'
                printf '        strategy: round\n'
                printf '      nodes:\n'
                node_index=0
                for domain in "${domains[@]}"; do
                    ((node_index += 1))
                    regex="$(regex_domain "$domain")"
                    node_name="$(slugify "$name-sni-$node_index")"
                    printf '        - name: "%s"\n' "$node_name"
                    printf '          addr: "%s"\n' "$endpoint"
                    # matcher implements the intended base-domain + arbitrary-subdomain rule.
                    # filter is an exact, fail-closed fallback if a future gost rejects matcher syntax.
                    printf "          matcher:\n"
                    printf "            rule: 'Proto(\`tls\`) && HostRegexp(\`^([a-z0-9-]+\\.)*%s$\`)'\n" "$regex"
                    printf '          filter:\n'
                    printf '            protocol: tls\n'
                    printf '            host: "%s"\n' "$domain"
                done
            done < "$FORWARDS_FILE"
        fi

        if (( ${#domains[@]} > 0 )); then
            printf '\nbypasses:\n'
            printf '  - name: "global-sni-allowlist"\n'
            printf '    whitelist: true\n'
            printf '    matchers:\n'
            for domain in "${domains[@]}"; do
                # Leading dot is gost's boundary-aware base + subdomain matcher.
                printf '      - ".%s"\n' "$domain"
            done
        fi
        printf '\nlog:\n'
        printf '  output: stderr\n'
        printf '  level: info\n'
        printf '  format: text\n'
    } > "$output"
}

regenerate() {
    local tmp validation_output
    # GOST infers the parser from the filename extension, so the temp file
    # must still end in .yml during validation.
    tmp="$(mktemp "$STATE_DIR/gost.XXXXXX.yml")"
    if ! render_config "$tmp"; then
        rm -f -- "$tmp"
        warn "生成配置失败。"
        return 1
    fi
    if config_ready && [[ -x "$CORE_BIN" ]]; then
        if ! validation_output="$("$CORE_BIN" -C "$tmp" -O yaml 2>&1)"; then
            rm -f -- "$tmp"
            warn "gost 拒绝了新配置：${validation_output:-未知错误}"
            return 1
        fi
    fi
    if ! chmod 0644 "$tmp"; then
        rm -f -- "$tmp"
        warn "无法设置新配置文件权限。"
        return 1
    fi
    if ! mv -f -- "$tmp" "$CONFIG_FILE"; then
        rm -f -- "$tmp"
        warn "无法原子替换配置文件。"
        return 1
    fi
    apply_service
}

snapshot_state() {
    local backup="$1"
    mkdir -p -- "$backup"
    chmod 0700 "$backup" 2>/dev/null || true
    cp -a -- "$DOMAINS_FILE" "$FORWARDS_FILE" "$backup/"
    if [[ -f "$CONFIG_FILE" ]]; then
        cp -a -- "$CONFIG_FILE" "$backup/gost.yml"
        : > "$backup/had-config"
    fi
}

restore_state() {
    local backup="$1"
    cp -a -- "$backup/domains.txt" "$DOMAINS_FILE"
    cp -a -- "$backup/forwards.tsv" "$FORWARDS_FILE"
    if [[ -e "$backup/had-config" ]]; then
        cp -a -- "$backup/gost.yml" "$CONFIG_FILE"
    else
        rm -f -- "$CONFIG_FILE"
    fi
}

commit_change() {
    local backup="$1"
    if regenerate; then
        rm -rf -- "$backup"
        return 0
    fi
    restore_state "$backup"
    apply_service >/dev/null 2>&1 || true
    rm -rf -- "$backup"
    die "应用新配置失败，已恢复旧配置。"
}

domain_add() {
    (( $# > 0 )) || die "用法：gost domain add example.com [example.net ...]"
    local backup domain normalized changed=0
    backup="$(mktemp -d "$STATE_DIR/backup.XXXXXX")"
    snapshot_state "$backup"
    for domain in "$@"; do
        normalized="$(normalize_domain "$domain")"
        valid_domain "$normalized" || { restore_state "$backup"; rm -rf -- "$backup"; die "无效主域名：$domain（请填写 example.com，中文域名请先转为 Punycode）"; }
        if ! grep -Fqx -- "$normalized" "$DOMAINS_FILE"; then
            printf '%s\n' "$normalized" >> "$DOMAINS_FILE"
            changed=1
        fi
    done
    sort -u -o "$DOMAINS_FILE" "$DOMAINS_FILE"
    if (( changed )); then
        commit_change "$backup"
        info "全局 SNI 白名单已更新，主域名及其所有子域名均已放行。"
    else
        rm -rf -- "$backup"
        warn "域名已存在，没有改动。"
    fi
}

domain_delete() {
    (( $# == 1 )) || die "用法：gost domain delete example.com"
    local backup domain tmp
    domain="$(normalize_domain "$1")"
    grep -Fqx -- "$domain" "$DOMAINS_FILE" || die "域名不存在：$domain"
    backup="$(mktemp -d "$STATE_DIR/backup.XXXXXX")"
    snapshot_state "$backup"
    tmp="$(mktemp "$STATE_DIR/domains.XXXXXX")"
    grep -Fvx -- "$domain" "$DOMAINS_FILE" > "$tmp" || true
    mv -f -- "$tmp" "$DOMAINS_FILE"
    chmod 0600 "$DOMAINS_FILE"
    commit_change "$backup"
    info "已删除主域名 $domain。"
}

domain_list() {
    printf '%s全局 SNI 主域名白名单%s\n' "$C_BOLD" "$C_RESET"
    if [[ ! -s "$DOMAINS_FILE" ]]; then
        printf '  （空）\n'
        return
    fi
    local index=1 domain
    while IFS= read -r domain; do
        [[ -n "$domain" ]] || continue
        printf '  %d. %s  （含 *.%s）\n' "$index" "$domain" "$domain"
        ((index++))
    done < "$DOMAINS_FILE"
}

forward_add() {
    (( $# >= 2 && $# <= 4 )) || die "用法：gost forward add <监听端口> <目标IPv4> [目标端口=443] [名称]"
    local listen_port="$1" target="$2" target_port="${3:-443}" name="${4:-forward-$1}"
    valid_port "$listen_port" || die "无效监听端口：$listen_port"
    valid_port "$target_port" || die "无效目标端口：$target_port"
    valid_target "$target" || die "无效目标 IPv4：$target（只支持 IPv4，不支持 IPv6 或域名）"
    valid_rule_name "$name" || die "名称只能包含字母、数字、下划线、连字符，最长 32 位。"
    awk -F '\t' -v port="$listen_port" '$2 == port {found=1} END {exit !found}' "$FORWARDS_FILE" && die "监听端口 $listen_port 已存在。"
    awk -F '\t' -v rule="$name" '$1 == rule {found=1} END {exit !found}' "$FORWARDS_FILE" && die "转发名称 $name 已存在。"
    if command -v ss >/dev/null 2>&1 && ss -H -ltn "sport = :$listen_port" 2>/dev/null | grep -q .; then
        die "端口 $listen_port 已被其他程序占用，请更换端口或先停止冲突服务。"
    fi
    local backup
    backup="$(mktemp -d "$STATE_DIR/backup.XXXXXX")"
    snapshot_state "$backup"
    printf '%s\t%s\t%s\t%s\n' "$name" "$listen_port" "$target" "$target_port" >> "$FORWARDS_FILE"
    commit_change "$backup"
    info "已添加：0.0.0.0:$listen_port -> $(format_endpoint "$target" "$target_port")（受全局 SNI 白名单保护）"
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
        warn "UFW 正在运行；如外部无法访问，请执行：ufw allow ${listen_port}/tcp"
    fi
}

forward_delete() {
    (( $# == 1 )) || die "用法：gost forward delete <名称或监听端口>"
    local key="$1" backup tmp
    awk -F '\t' -v key="$key" '$1 == key || $2 == key {found=1} END {exit !found}' "$FORWARDS_FILE" || die "未找到转发：$key"
    backup="$(mktemp -d "$STATE_DIR/backup.XXXXXX")"
    snapshot_state "$backup"
    tmp="$(mktemp "$STATE_DIR/forwards.XXXXXX")"
    awk -F '\t' -v key="$key" '$1 != key && $2 != key' "$FORWARDS_FILE" > "$tmp"
    mv -f -- "$tmp" "$FORWARDS_FILE"
    chmod 0600 "$FORWARDS_FILE"
    commit_change "$backup"
    info "已删除转发 $key。"
}

forward_list() {
    printf '%sTCP IPv4 转发规则%s\n' "$C_BOLD" "$C_RESET"
    if [[ ! -s "$FORWARDS_FILE" ]]; then
        printf '  （空）\n'
        return
    fi
    printf '  %-18s %-12s %s\n' '名称' 'TCP监听端口' '唯一固定IPv4目标'
    while IFS=$'\t' read -r name listen_port target target_port; do
        [[ -n "$name" ]] || continue
        printf '  %-18s %-12s %s\n' "$name" "$listen_port/tcp" "$(format_endpoint "$target" "$target_port")"
    done < "$FORWARDS_FILE"
}

show_status() {
    local enabled_state="未知" restart_count="0" listen_info
    domain_list
    printf '\n'
    forward_list
    printf '\n%s服务状态%s\n' "$C_BOLD" "$C_RESET"
    if systemctl_available; then
        enabled_state="$(systemctl is-enabled "$SERVICE_NAME" 2>/dev/null || true)"
        restart_count="$(systemctl show "$SERVICE_NAME" -p NRestarts --value 2>/dev/null || printf '0')"
        if systemctl is-active --quiet "$SERVICE_NAME"; then
            printf '  %s运行中%s\n' "$C_GREEN" "$C_RESET"
        else
            printf '  %s未运行%s\n' "$C_RED" "$C_RESET"
        fi
        printf '  开机启动：%s | 异常重启次数：%s\n' "$enabled_state" "$restart_count"
        systemctl --no-pager --full status "$SERVICE_NAME" 2>/dev/null | sed -n '1,5p' || true
    else
        printf '  测试模式（未调用 systemd）\n'
    fi
    if command -v ss >/dev/null 2>&1 && [[ -s "$FORWARDS_FILE" ]]; then
        printf '\n%s监听检查%s\n' "$C_BOLD" "$C_RESET"
        while IFS=$'\t' read -r _name listen_port _target _target_port; do
            listen_info="$(ss -ltnH "sport = :$listen_port" 2>/dev/null || true)"
            if [[ -n "$listen_info" ]]; then
                printf '%s\n' "$listen_info" | sed 's/^/  /'
            else
                printf '  TCP %s：未监听\n' "$listen_port"
            fi
        done < "$FORWARDS_FILE"
    fi
}

show_logs() {
    systemctl_available || die "当前环境没有 systemd。"
    journalctl -u "$SERVICE_NAME" -n 100 --no-pager
}

restart_service() {
    systemctl_available || die "当前环境没有 systemd。"
    config_ready || die "请先添加至少一个主域名和一条 TCP IPv4 转发。"
    regenerate
    info "服务已重启。"
}

update_project() {
    local tmp
    tmp="$(mktemp "$STATE_DIR/install.XXXXXX")"
    curl -fsSL --retry 3 "https://raw.githubusercontent.com/${PROJECT_REPO}/${PROJECT_REF}/install.sh" -o "$tmp"
    # Avoid inheriting the manager lock: the installer invokes the new manager.
    exec 9>&-
    bash "$tmp" --upgrade
    rm -f -- "$tmp"
}

uninstall_project() {
    local answer="${1:-}" backup_path=""
    if [[ "$answer" != "--yes" ]]; then
        read -r -p '确认卸载服务和管理配置？输入 YES 继续：' answer < /dev/tty
        [[ "$answer" == YES ]] || { warn "已取消。"; return; }
    fi
    if systemctl_available; then
        systemctl disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
        rm -f -- "/etc/systemd/system/$SERVICE_NAME"
        systemctl daemon-reload
    fi
    if [[ -r "$INSTALL_ROOT/original-gost.path" ]]; then
        backup_path="$(head -n1 "$INSTALL_ROOT/original-gost.path")"
    fi
    rm -rf -- "$STATE_DIR"
    rm -f -- "$COMPAT_MANAGER_BIN" "$MANAGER_BIN"
    if [[ "$backup_path" == /usr/local/bin/gost.before-gost-sni.* && -f "$backup_path" ]]; then
        cp -a -- "$backup_path" "$MANAGER_BIN"
        info "已恢复安装前的原始 gost：$MANAGER_BIN"
    fi
    rm -rf -- "$INSTALL_ROOT"
    info "服务、菜单、内部核心和配置已移除。"
}

domain_menu() {
    while true; do
        clear 2>/dev/null || true
        domain_list
        printf '\n1. 添加主域名\n2. 删除主域名\n0. 返回\n'
        read -r -p '请选择：' choice < /dev/tty
        case "$choice" in
            1)
                read -r -p '输入主域名（多个用空格分隔）：' line < /dev/tty
                # Intentional word splitting: the prompt explicitly accepts a space-separated list.
                # shellcheck disable=SC2086
                domain_add $line
                read -r -p '按回车继续...' _ < /dev/tty
                ;;
            2)
                read -r -p '输入要删除的主域名：' domain < /dev/tty
                domain_delete "$domain"
                read -r -p '按回车继续...' _ < /dev/tty
                ;;
            0) return ;;
            *) warn "无效选择。"; sleep 1 ;;
        esac
    done
}

add_forward_prompt() {
    local listen_port target target_port name again
    while true; do
        read -r -p '服务器 TCP 监听端口 [443]：' listen_port < /dev/tty
        listen_port="${listen_port:-443}"
        read -r -p 'Cloudflare/上游固定 IPv4：' target < /dev/tty
        read -r -p '目标端口 [443]：' target_port < /dev/tty
        target_port="${target_port:-443}"
        read -r -p "规则名称 [forward-$listen_port]：" name < /dev/tty
        name="${name:-forward-$listen_port}"
        forward_add "$listen_port" "$target" "$target_port" "$name"
        printf '\n每个监听端口只对应一个 IPv4:端口。\n'
        read -r -p '继续添加另一条转发？[y/N]：' again < /dev/tty
        [[ "$again" =~ ^[yY]$ ]] || return
    done
}

delete_forward_prompt() {
    forward_list
    local key
    read -r -p '输入要删除的名称或监听端口：' key < /dev/tty
    forward_delete "$key"
}

main_menu() {
    while true; do
        clear 2>/dev/null || true
        printf '%s========================================%s\n' "$C_BLUE$C_BOLD" "$C_RESET"
        printf '%s  GOST TCP IPv4 + 全局 SNI 白名单%s\n' "$C_BLUE$C_BOLD" "$C_RESET"
        printf '%s========================================%s\n' "$C_BLUE$C_BOLD" "$C_RESET"
        local domain_count forward_count state
        domain_count="$(sed '/^[[:space:]]*$/d' "$DOMAINS_FILE" | wc -l)"
        forward_count="$(sed '/^[[:space:]]*$/d' "$FORWARDS_FILE" | wc -l)"
        state="未运行"
        if systemctl_available && systemctl is-active --quiet "$SERVICE_NAME"; then state="运行中"; fi
        printf '状态：%s | 主域名：%s | 转发：%s\n\n' "$state" "$domain_count" "$forward_count"
        printf '1. 设置全局 SNI 主域名\n'
        printf '2. 添加 TCP IPv4 转发（支持多条）\n'
        printf '3. 删除 TCP IPv4 转发\n'
        printf '4. 查看全部配置和状态\n'
        printf '5. 查看最近日志\n'
        printf '6. 重启并检查服务\n'
        printf '7. 更新程序\n'
        printf '8. 卸载\n'
        printf '0. 退出\n\n'
        read -r -p '请选择 [0-8]：' choice < /dev/tty
        case "$choice" in
            1) domain_menu ;;
            2) add_forward_prompt; read -r -p '按回车继续...' _ < /dev/tty ;;
            3) delete_forward_prompt; read -r -p '按回车继续...' _ < /dev/tty ;;
            4) show_status; read -r -p '按回车继续...' _ < /dev/tty ;;
            5) show_logs; read -r -p '按回车继续...' _ < /dev/tty ;;
            6) restart_service; read -r -p '按回车继续...' _ < /dev/tty ;;
            7) update_project; return ;;
            8) uninstall_project; return ;;
            0) return ;;
            *) warn "无效选择。"; sleep 1 ;;
        esac
    done
}

usage() {
    cat <<'EOF'
用法：
  gost                                  打开可视化菜单
  gost domain list
  gost domain add example.com [example.net ...]
  gost domain delete example.com
  gost forward list
  gost forward add <监听端口> <目标IPv4> [目标端口=443] [名称]
  gost forward delete <名称或监听端口>
  gost status | logs | restart | update | uninstall
EOF
}

main() {
    require_root "$@"
    init_state
    exec 9>"$LOCK_FILE"
    if command -v flock >/dev/null 2>&1; then
        flock -x 9
    fi

    local command="${1:-menu}"
    shift || true
    case "$command" in
        menu) main_menu ;;
        init) regenerate ;;
        domain)
            local action="${1:-list}"; shift || true
            case "$action" in
                list) domain_list ;;
                add) domain_add "$@" ;;
                delete|del|rm) domain_delete "$@" ;;
                *) usage; exit 2 ;;
            esac
            ;;
        forward)
            local action="${1:-list}"; shift || true
            case "$action" in
                list) forward_list ;;
                add) forward_add "$@" ;;
                delete|del|rm) forward_delete "$@" ;;
                *) usage; exit 2 ;;
            esac
            ;;
        status) show_status ;;
        logs) show_logs ;;
        restart) restart_service ;;
        update) update_project ;;
        uninstall) uninstall_project "$@" ;;
        config) cat "$CONFIG_FILE" ;;
        -h|--help|help) usage ;;
        *) usage; exit 2 ;;
    esac
}

main "$@"
