[Unit]
Description=GOST fixed-IP forwarder with global SNI allowlist
Documentation=https://github.com/666speed/gost-sni-forward
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/etc/gost-sni-forward
ExecStartPre=/bin/sh -c 'exec /usr/local/lib/gost-sni-forward/gost-core -C /etc/gost-sni-forward/gost.yml -O yaml >/dev/null'
ExecStart=/usr/local/lib/gost-sni-forward/gost-core -C /etc/gost-sni-forward/gost.yml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=1048576
TasksMax=512
UMask=0027
StandardOutput=journal
StandardError=journal

# Only low-port binding and outbound TCP/IP are needed.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
