# In BT/aaPanel, set the site's run directory to /public. The generated server
# block already contains fastcgi_pass; merge only the directives you need.

root /www/wwwroot/relay.example.com/public;
index index.php;

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

location ~ \.php$ {
    include fastcgi.conf;
    fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    # Keep the PHP socket/path generated by BT/aaPanel, for example:
    # fastcgi_pass unix:/tmp/php-cgi-81.sock;
}

location ~ ^/(?:config|database|src|views)/ {
    deny all;
}
